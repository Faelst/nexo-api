# Banco (docker compose up -d)
DATABASE_URL="postgresql://nexo:nexo@localhost:5440/nexo_assist?schema=public"

# API
PORT=3333
FRONTEND_URL=http://localhost:3000
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=8h

# Agent (Mastra). LLM_MODEL usa o formato provedor/modelo; preencha a chave do provedor escolhido.
LLM_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=

# Alternativa: LLM_MODEL=anthropic/claude-haiku-5-5 com ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Limite de mensagens do funcionário por sessão de conversa
MAX_SESSION_MESSAGES=30

# Simulação do sistema de chamados legado (0 a 1): chance de ficar indisponível em cada chamada
LEGACY_FAILURE_RATE=0.08
